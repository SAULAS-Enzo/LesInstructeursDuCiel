<mxfile host="Electron" pages="4">
  <diagram id="KaIE3xR3Vjy-IWzthDOC" name="DF &amp; Contraintes">
    <mxGraphModel dx="975" dy="612" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hJtJWiAHvl0c5HbtJ9tg-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Dépendances fonctionnelles&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Personnes et formations&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;DF1 : idPers → nomP, prenomP, dateDeNaissanceP, emailP, motDePasse&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF2 : idAppP → nbHeuresVol, nomF (formation en cours, via SUIVRE)&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF3 : idIns → nbHeuresVol&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF4 : nomF → descriptionF, formationNecessaire&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF5 : idPers, nomF → dateObtention (via POSSEDER)&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Vols&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;DF6 : idV → aerodromeDepart, aerodromeArrivee, dureeV, planDeV, regleV, dateV, heureV, idAppP, idIns, idA&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF7 : idAppP, dateV, heureV → idV, idA, idIns&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF8 : idIns, dateV, heureV → idV, idA, idAppP&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Avions et contrôles techniques&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;DF9 : idA → nomA, typeA, specification, anneeDeFabrication, dateLimiteRevision, imgA, vitesseDeCroisiere, altitudeMax, autonomie, aerodromeActuel&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF10 : idCT → estValideCT, dateCT, heureCT, idA, idTech&lt;/li&gt;&lt;br/&gt;&lt;li&gt;DF11 : idTech, dateCT → idCT, idA&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Contraintes&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Vols et avions&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;C1 : un avion ne peut pas être sur deux vols qui se chevauchent dans le temps (intervalle [dateV + heureV, + dureeV]).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C2 : aerodromeDepart d&#39;un vol doit être égal à aerodromeActuel de l&#39;avion. Une fois le vol terminé, aerodromeActuel prend la valeur de aerodromeArrivee.&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C3 : un contrôle technique ne peut avoir lieu que si l&#39;avion n&#39;est dans aucun vol à ce moment-là (dateCT, heureCT).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C4 : dureeV doit être strictement inférieure à l&#39;autonomie de l&#39;avion (même unité).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C5 : un avion ne peut décoller que si son dernier contrôle technique a estValideCT = vrai.&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C6 : un avion ne peut pas décoller si dateV est postérieure à dateLimiteRevision.&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Formations&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;C7 : un instructeur ne peut encadrer un vol que si la formation en cours de l&#39;apprenti (SUIVRE) fait partie des formations qu&#39;il enseigne (FORMER).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C8 : un apprenti ne peut voler que sur un avion lié, via CONVENIR, à sa formation en cours.&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C9 : un instructeur a au moins 200 heures de vol (nbHeuresVol ≥ 200).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;C10 : une personne ne peut suivre ou obtenir une formation que si sa formation requise (formationNecessaire) figure déjà dans ses formations obtenues (POSSEDER). Cela vaut pour les deux chaînes :&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;pilotes : BIA → ABL → LAPL → PPL → CPL → ATPL → MPL&lt;/li&gt;&lt;br/&gt;&lt;li&gt;instructeurs : CAEA → IR → QT → MCC&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;Contrainte de cohérence liée à DF7 et DF8&lt;/p&gt;&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;C11 : un apprenti ou un instructeur ne peut pas être sur deux vols qui se chevauchent. Les DF7 et DF8 ne bloquent que deux vols qui démarrent exactement à la même heure.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1490" width="820" x="80" y="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
