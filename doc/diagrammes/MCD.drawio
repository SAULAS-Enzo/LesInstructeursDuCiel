  <diagram id="deuwTuvFbsaTTfS4R9hc" name="MLD">
    <mxGraphModel dx="3535" dy="2220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lmOJKjS4U3bX0Sf5-4BB-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;ltr&quot;&gt;PERSONNE(&lt;u style=&quot;&quot;&gt;idPers&lt;/u&gt;, nomP, prenomP, dateDeNaissanceP, emailP, motDePasse)&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;FORMATION(&lt;u style=&quot;&quot;&gt;nomF&lt;/u&gt;, descriptionF, #formationNecessaire)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;formationNecessaire → FORMATION(nomF), NULL pour BIA et CAEA&lt;/li&gt;&lt;br&gt;&lt;li&gt;vient de REQUIRE&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;APPRENTI_PILOTE(&lt;b&gt;#&lt;/b&gt;&lt;u style=&quot;&quot;&gt;idAppP&lt;/u&gt;, nbHeuresVol, #nomF)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idAppP → PERSONNE(idPers)&lt;/li&gt;&lt;br&gt;&lt;li&gt;nomF → FORMATION(nomF), NULL si plus de formation en cours&lt;/li&gt;&lt;br&gt;&lt;li&gt;nomF vient de SUIVRE&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;INSTRUCTEUR(&lt;strong&gt;#&lt;/strong&gt;&lt;u&gt;idIns&lt;/u&gt;, nbHeuresVol)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idIns → PERSONNE(idPers)&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;TECHNICIEN(&lt;b&gt;#&lt;/b&gt;&lt;u style=&quot;&quot;&gt;idTech&lt;/u&gt;)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idTech → PERSONNE(idPers)&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;AVION(&lt;u&gt;idA&lt;/u&gt;, nomA, typeA, specification, anneeDeFabrication, dateLimiteRevision, imgA, vitesseDeCroisiere, altitudeMax, autonomie, aerodromeActuel)&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;VOLS(&lt;u&gt;idV&lt;/u&gt;, aerodromeDepart, aerodromeArrivee, dureeV, planDeV, regleV, dateV, heureV, #idAppP, #idIns, #idA)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idAppP → APPRENTI_PILOTE(idAppP), vient de RESERVER&lt;/li&gt;&lt;br&gt;&lt;li&gt;idIns → INSTRUCTEUR(idIns), vient de ENCADRER&lt;/li&gt;&lt;br&gt;&lt;li&gt;idA → AVION(idA), vient de CONCERNER&lt;/li&gt;&lt;br&gt;&lt;li&gt;les trois clés étrangères sont NOT NULL (cardinalités (1,1))&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;CONTROLE_TECHNIQUE(&lt;u&gt;idCT&lt;/u&gt;, estValideCT, dateCT, heureCT, #idTech, #idA)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idTech → TECHNICIEN(idTech), vient de PROCEDER&lt;/li&gt;&lt;br&gt;&lt;li&gt;idA → AVION(idA), vient de CONTROLER&lt;/li&gt;&lt;br&gt;&lt;li&gt;les deux clés étrangères sont NOT NULL&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;POSSEDER(&lt;u&gt;&lt;b style=&quot;&quot;&gt;#&lt;/b&gt;idPers&lt;b style=&quot;&quot;&gt;, #&lt;/b&gt;nomF&lt;/u&gt;, dateObtention)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idPers → PERSONNE(idPers)&lt;/li&gt;&lt;br&gt;&lt;li&gt;nomF → FORMATION(nomF)&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;FORMER(&lt;u&gt;#idIns, #nomF&lt;/u&gt;)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idIns → INSTRUCTEUR(idIns)&lt;/li&gt;&lt;br&gt;&lt;li&gt;nomF → FORMATION(nomF)&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;CONVENIR(&lt;u&gt;#idA, #nomF&lt;/u&gt;)&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;idA → AVION(idA)&lt;/li&gt;&lt;br&gt;&lt;li&gt;nomF → FORMATION(nomF)&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;&lt;br&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Contraintes d&#39;unicité et CHECK à déclarer&lt;/strong&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;VOLS : UNIQUE(idAppP, dateV, heureV) (DF7) et UNIQUE(idIns, dateV, heureV) (DF8).&lt;/li&gt;&lt;br&gt;&lt;li&gt;CONTROLE_TECHNIQUE : UNIQUE(idTech, dateCT) (DF11).&lt;/li&gt;&lt;br&gt;&lt;li&gt;PERSONNE : UNIQUE(emailP).&lt;/li&gt;&lt;br&gt;&lt;li&gt;INSTRUCTEUR : CHECK(nbHeuresVol &amp;gt;= 200) (C9).&lt;/li&gt;&lt;br&gt;&lt;li&gt;AVION : CHECK(autonomie &amp;gt; 0), VOLS : CHECK(dureeV &amp;gt; 0).&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Contraintes à traiter par triggers&lt;/strong&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;C1 et C11 : chevauchement de vols, sur VOLS (par avion, par apprenti, par instructeur).&lt;/li&gt;&lt;br&gt;&lt;li&gt;C2 : aerodromeDepart = AVION.aerodromeActuel, et mise à jour de aerodromeActuel après le vol.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C3 : INSERT dans CONTROLE_TECHNIQUE refusé si l&#39;avion a un vol à ce moment-là.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C4 : dureeV &amp;lt; AVION.autonomie.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C5 : le dernier CONTROLE_TECHNIQUE de l&#39;avion doit avoir estValideCT = vrai.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C6 : dateV &amp;lt;= AVION.dateLimiteRevision.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C7 : APPRENTI_PILOTE.nomF doit exister dans FORMER pour l&#39;instructeur du vol.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C8 : APPRENTI_PILOTE.nomF doit exister dans CONVENIR pour l&#39;avion du vol.&lt;/li&gt;&lt;br&gt;&lt;li&gt;C10 : on n&#39;ajoute une ligne dans POSSEDER ou on ne modifie APPRENTI_PILOTE.nomF que si FORMATION.formationNecessaire est déjà dans POSSEDER pour cette personne.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="1660" width="560" x="170" y="610" as="geometry" />
        </mxCell>
        <mxCell id="lmOJKjS4U3bX0Sf5-4BB-2" edge="1" parent="1" source="lmOJKjS4U3bX0Sf5-4BB-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;" target="lmOJKjS4U3bX0Sf5-4BB-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
